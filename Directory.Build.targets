<Project>

  <!--
    Local dev only: Windows Smart App Control has been observed blocking execution of
    freshly-built, unsigned test binaries on this machine (Code Integrity policy block,
    not a malware detection). Signing with a local self-signed cert installed into
    CurrentUser\TrustedPublisher works around it. Debug + Windows + test projects only —
    this has nothing to do with real release signing, which is a separate concern for the
    release pipeline (a CA-issued cert or a free OSS signing service).

    Safe no-op on machines without the cert (see build/Sign-LocalTestBinary.ps1) and on
    non-Windows/CI, so this does not need to be conditional per contributor.
  -->
  <Target Name="SignLocalTestBinary"
          AfterTargets="Build"
          Condition="'$(IsTestProject)' == 'true' AND '$(OS)' == 'Windows_NT' AND '$(Configuration)' == 'Debug'">
    <!--
      Signs every DLL/EXE in the output directory, not just this project's own assembly —
      copied dependencies (Avalonia.*.dll, SQLitePCLRaw.provider.e_sqlite3.dll, and similar)
      have all been observed independently blocked by Smart App Control. See
      build/Sign-LocalTestBinary.ps1 and PROGRESS.md's M1b entry for what motivated this.
    -->
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)build\Sign-LocalTestBinary.ps1&quot; -Directory &quot;$(TargetDir.TrimEnd('\'))&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>

</Project>
