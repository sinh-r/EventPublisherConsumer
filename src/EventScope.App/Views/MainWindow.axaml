<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:EventScope.App.ViewModels"
        xmlns:views="using:EventScope.App.Views"
        xmlns:publisher="using:EventScope.App.Publisher"
        xmlns:conv="using:Avalonia.Data.Converters"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="1000"
        x:Class="EventScope.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="EventScope"
        Width="1600" Height="1000"
        MinWidth="1280" MinHeight="800"
        Background="{DynamicResource Bg}">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <!-- JSON colouring (build plan §4.5), shared by the publisher preview pane. Declarative
         Classes bindings on each segment's TextBlock, the same safe pattern as the message
         grid's own .large/.searchHit classes below. -->
    <Window.Styles>
        <Style Selector="TextBlock.key">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock.str">
            <Setter Property="Foreground" Value="{DynamicResource Green}" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="Foreground" Value="{DynamicResource Amber}" />
        </Style>
        <Style Selector="TextBlock.lit">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>
        <Style Selector="TextBlock.punct">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
        </Style>

        <!-- Tab strip active-tab underline (UI spec §4.1) - a declarative Classes binding on
             ConnectionTabViewModel.IsSelected, the same safe pattern already proven for the
             message grid's .large/.searchHit cells rather than an imperative Classes.Set. -->
        <Style Selector="Border.tabItem">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.tabItem.active">
            <Setter Property="Background" Value="{DynamicResource Surf}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="4" />
            <RowDefinition Height="320" MinHeight="120" MaxHeight="620" />
            <!-- Publisher panel (build plan §5 M3) - Auto rather than a fixed pixel height so
                 the row collapses to zero when IsPublisherOpen is false (Avalonia excludes an
                 IsVisible="False" element from layout entirely, so an Auto row sizes to
                 nothing). Deliberately not drag-resizable like the detail pane's splitter
                 above - GridSplitter mutates its target RowDefinition's Height directly, which
                 would turn this row from Auto into a fixed pixel value on the first drag and
                 defeat the collapse-on-close behaviour; the publisher panel's own inner Border
                 carries the §4.3 default/clamp numbers as a fixed Height instead. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- Tab strip (§4.1 of the UI spec). One tab per connection opened this session (not
             one per view - a connection tab, per the spec's own wording) plus a trailing +
             that reopens the connection manager / launcher overlay below. -->
        <Border Grid.Row="0" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Height="36" x:CompileBindings="False">
                <ItemsControl ItemsSource="{Binding Tabs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="tabItem" Classes.active="{Binding IsSelected}"
                                    BorderThickness="0,0,0,2" Padding="12,0" Height="36">
                                <Grid ColumnDefinitions="Auto,Auto,Auto">
                                    <Button Grid.ColumnSpan="2" Grid.Column="0"
                                            Command="{Binding $parent[Window].DataContext.SelectTabCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent" BorderThickness="0" Padding="0"
                                            HorizontalContentAlignment="Left">
                                        <Grid ColumnDefinitions="Auto,Auto">
                                            <Panel Grid.Column="0" Width="6" Height="6" Margin="0,0,8,0" VerticalAlignment="Center">
                                                <Ellipse Fill="{DynamicResource Green}" IsVisible="{Binding IsStreaming}" />
                                                <Ellipse Fill="{DynamicResource Amber}" IsVisible="{Binding IsDegraded}" />
                                                <Ellipse Fill="{DynamicResource Red}" IsVisible="{Binding IsError}" />
                                                <Ellipse Fill="{DynamicResource Dim}" IsVisible="{Binding IsIdle}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                                                       Foreground="{DynamicResource Text}" />
                                        </Grid>
                                    </Button>
                                    <Button Grid.Column="2" Content="×" Margin="8,0,0,0"
                                            Command="{Binding $parent[Window].DataContext.CloseTabCommand}"
                                            CommandParameter="{Binding}"
                                            Width="16" Height="16" Padding="0" VerticalAlignment="Center"
                                            Background="Transparent" BorderThickness="0"
                                            Foreground="{DynamicResource Dim}" FontSize="12" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Button Content="+" Command="{Binding ToggleConnectionManagerCommand}"
                        Width="36" Height="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Muted}" FontSize="16"
                        ToolTip.Tip="Add connection" />
            </StackPanel>
        </Border>

        <!-- Connection toolbar. -->
        <Border Grid.Row="1" Background="{DynamicResource Surf}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                <Panel Grid.Column="0" Width="8" Height="8" Margin="0,0,8,0">
                    <Ellipse Fill="{DynamicResource Green}" IsVisible="{Binding Toolbar.IsRunning}" />
                    <Ellipse Fill="{DynamicResource Dim}" IsVisible="{Binding !Toolbar.IsRunning}" />
                </Panel>

                <!-- Source selector display (UI spec §4.2: "Shows broker type icon-glyph,
                     then topic-name"). A read-only label, not a live dropdown - the
                     connection to show here is chosen via the tab strip and the connection
                     manager, not from within the toolbar itself. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Toolbar.ConnectionName}"
                               FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                               Foreground="{DynamicResource Text}" />
                    <TextBlock Text="{Binding Toolbar.TopicLabel}" IsVisible="{Binding Toolbar.TopicLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Muted}" />
                    <TextBlock Text="{Binding Toolbar.PartitionLabel}" IsVisible="{Binding Toolbar.PartitionLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Dim}" />
                    <TextBlock Text="{Binding Toolbar.StatusLabel}"
                               FontFamily="{DynamicResource SansFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Start" Command="{Binding ToggleRunCommand}"
                            IsVisible="{Binding !Toolbar.IsRunning}"
                            Background="Transparent" BorderBrush="{DynamicResource Accent}"
                            Foreground="{DynamicResource Accent}" Padding="12,4"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                    <Button Content="Stop" Command="{Binding ToggleRunCommand}"
                            IsVisible="{Binding Toolbar.IsRunning}"
                            Background="Transparent" BorderBrush="{DynamicResource Red}"
                            Foreground="{DynamicResource Red}" Padding="12,4"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                </StackPanel>

                <!-- Capability-bound indicator, not a broker-type switch: every element here
                     reads a SourceCapabilities flag. -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0">
                    <!-- Read-mode segmented control (UI spec §4.2). Consume is permanently
                         disabled here: KafkaSourceOptions deliberately forbids a fixed
                         consumer group id (see its own remarks) - a real committing "Consume"
                         mode would need one, and that is exactly the property that keeps this
                         tool from disturbing a real consumer group's offsets. Reversing that
                         is a deliberate decision for later, not assumed by this pass. -->
                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="5"
                            Background="{DynamicResource AccentTint}" Padding="10,4">
                        <TextBlock Text="Peek" Foreground="{DynamicResource Accent}"
                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                    </Border>
                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="5"
                            Padding="10,4" Opacity="0.4"
                            ToolTip.Tip="Not available — this tool never uses a fixed consumer group id, to avoid disturbing a real consumer group's offsets.">
                        <TextBlock Text="Consume" Foreground="{DynamicResource Text}"
                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                    </Border>
                    <TextBlock Text="partitioned" IsVisible="{Binding Toolbar.SupportsPartitions}"
                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Muted}" />
                </StackPanel>

                <TextBlock Grid.Column="5" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                           Foreground="{DynamicResource Muted}"
                           Text="{Binding Toolbar.MessagesPerSecond, StringFormat='{}{0:N0} msg/s'}" />

                <!-- Toggles the bottom publisher panel (build plan §5 M3) - a resizable dock,
                     not a workspace switch, matching the mockup's own onTogglePublisher
                     button rather than the top tab strip. -->
                <Button Grid.Column="6" Content="Publish" Command="{Binding TogglePublisherCommand}"
                        Margin="16,0,0,0" Background="Transparent" BorderBrush="{DynamicResource Line}"
                        Foreground="{DynamicResource Text}" Padding="10,4"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />

                <!-- Browsing what was already captured. Deliberately next to Publish/Settings
                     rather than in the tab strip: it is a way of looking at the current
                     connection, not a different connection. -->
                <Button Grid.Column="7" Content="History" Command="{Binding ToggleHistoryCommand}"
                        Margin="8,0,0,0" Background="Transparent" BorderBrush="{DynamicResource Line}"
                        Foreground="{DynamicResource Text}" Padding="10,4"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />

                <Button Grid.Column="8" Content="Settings" Command="{Binding ToggleSettingsCommand}"
                        Margin="8,0,0,0" Background="Transparent" BorderBrush="{DynamicResource Line}"
                        Foreground="{DynamicResource Text}" Padding="10,4"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
            </Grid>
        </Border>

        <!-- Warning banner. Collapses naturally when the connected source can peek
             non-destructively (true for FakeEventSource and Kafka - unreachable until SQS
             lands in M4) - and the connection-error banner (UI spec §10's Error state: "Red
             tab dot, banner with broker error text, retry button"). Both bound independently
             in the same row rather than merged into one computed banner: no source in this
             pass can ever be both peek-incapable and errored at once (only Kafka and Fake
             exist, and Kafka.CanPeekNonDestructively is always true), so the two conditions
             are mutually exclusive in practice today. -->
        <Border Grid.Row="2" Height="36" Background="{DynamicResource AmberTint}"
                BorderBrush="{DynamicResource Amber}" BorderThickness="0,0,0,1" Padding="14,0"
                IsVisible="{Binding !Toolbar.CanPeekNonDestructively}">
            <TextBlock Text="This source cannot peek non-destructively — consuming removes messages."
                       VerticalAlignment="Center" Foreground="{DynamicResource Amber}"
                       FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
        </Border>
        <Border Grid.Row="2" Height="36" Background="{DynamicResource RedTint}"
                BorderBrush="{DynamicResource Red}" BorderThickness="0,0,0,1" Padding="14,0"
                IsVisible="{Binding HasConnectionError}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding ConnectionErrorText}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Red}"
                           FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                <Button Grid.Column="1" Content="Retry" Command="{Binding RetryCommand}"
                        Background="Transparent" BorderBrush="{DynamicResource Red}"
                        Foreground="{DynamicResource Red}" Padding="10,3"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
            </Grid>
        </Border>

        <!-- History mode. Says plainly that the grid is no longer showing live traffic, and that
             capture is still running underneath - the live ring is pinned, not stopped. -->
        <Border Grid.Row="2" Height="36" Background="{DynamicResource AmberTint}"
                BorderBrush="{DynamicResource Amber}" BorderThickness="0,0,0,1" Padding="14,0"
                IsVisible="{Binding IsHistoryMode}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Amber}"
                           FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                           Text="{Binding History.OpenDescription, StringFormat='Browsing {0} — live capture continues in the background.'}" />
                <Button Grid.Column="1" Content="Back to live" Command="{Binding BackToLiveCommand}"
                        Background="Transparent" BorderBrush="{DynamicResource Amber}"
                        Foreground="{DynamicResource Amber}" Padding="10,3"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
            </Grid>
        </Border>

        <!-- Search bar. Three tiers wired here: the instant ring filter (every keystroke, no
             delay - highlights matching rows already on screen), body FTS (debounced, reports
             a match count and whether the index is current), and deep scan (explicit, reads
             every full body off disk - its overlay sits over the grid below). The full
             Live/Today/20 days/Deep scope selector from UI spec §4.4 still needs the segmented
             control from §9's component inventory, which is Stage 5 - see SearchViewModel's
             remarks. -->
        <Border Grid.Row="3" Background="{DynamicResource Bg}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBox Grid.Column="0" Watermark="Search message bodies"
                         Text="{Binding Search.Query, Mode=TwoWay}"
                         VerticalAlignment="Center"
                         Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Line}"
                         Foreground="{DynamicResource Text}"
                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="10,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                               Foreground="{DynamicResource Muted}"
                               Text="{Binding Search.StatusText}" />
                    <!-- FTS searches every day file on disk, so matches routinely come from past
                         sessions. Opening them is an explicit gesture rather than something the
                         debounced search does per keystroke - see SearchViewModel.ResultsRequested. -->
                    <Button Content="Show matches" Command="{Binding Search.ShowResultsCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Line}"
                            Foreground="{DynamicResource Text}" Padding="10,3"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                    <!-- The last-resort tier: reads every full body off disk, so it finds a
                         term past the 2 KB indexed prefix, or anything at all while the index
                         is behind. Minutes of work where FTS takes milliseconds, hence a
                         button rather than anything that fires as you type. -->
                    <Button Content="Deep scan" Command="{Binding Search.DeepScanCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Line}"
                            Foreground="{DynamicResource Text}" Padding="10,3"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12"
                            ToolTip.Tip="Reads every message body on disk. Slow, but finds what the index cannot." />
                    <TextBlock IsVisible="{Binding !Search.IndexIsCurrent}"
                               FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                               Foreground="{DynamicResource Amber}"
                               Text="index catching up"
                               ToolTip.Tip="Recent messages may not appear yet — the search index runs only while ingest is idle." />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Message grid. Both sources behind ActiveRows (the live ring and the history view)
             implement IDataGridCollectionView + IList directly, so DataGrid never wraps either in
             its own eagerly-enumerating DataGridCollectionView - see IGridRowsView's remarks, and
             HistoryGridVirtualizationTests, which measures that the mode switch keeps that
             property. -->
        <DataGrid Grid.Row="4" x:Name="MessageGrid"
                  x:CompileBindings="False"
                  ItemsSource="{Binding ActiveRows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserReorderColumns="False"
                  CanUserResizeColumns="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeight="26"
                  Background="{DynamicResource Bg}"
                  Foreground="{DynamicResource Text}"
                  BorderThickness="0"
                  LoadingRow="OnLoadingRow"
                  UnloadingRow="OnUnloadingRow"
                  SelectionChanged="OnGridSelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TIME" Width="100"
                                     Binding="{Binding Time, StringFormat='{}{0:HH:mm:ss.fff}'}" />
                <DataGridTextColumn Header="SUBJECT" Width="180" Binding="{Binding Subject}" />
                <DataGridTextColumn Header="CORRELATION ID" Width="260" Binding="{Binding CorrelationId}" />
                <!-- §4.4: the Size cell turns Amber for a large (>64 KB) row. A template
                     column (rather than DataGridTextColumn) so the cell's own TextBlock can
                     carry a bound Classes.large — direct element-level class binding is the
                     supported Avalonia mechanism; DataGridTextColumn has no per-cell
                     conditional-style hook. Also right-aligned per §4.3, which the plain
                     DataGridTextColumn version of this column never was. -->
                <DataGridTemplateColumn Header="SIZE" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Size}" Classes.large="{Binding IsLarge}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="6,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Spec width is 48 (Docs/eventscope-build-plan.md §4.3), but Avalonia's
                     DataGridColumnHeader chrome clips a 4-char uppercase header below ~64px
                     regardless of Padding — measured, not guessed. 70 matches SIZE, the
                     other 4-char header, which renders fully at that width. -->
                <DataGridTextColumn Header="PART" Width="70" Binding="{Binding Partition}" />
                <!-- §4.4: a search hit's preview gets an AmberTint background - the same
                     declarative Classes-binding pattern as the SIZE column above, not the
                     imperative per-row Classes.Set that the M1-remainder row-styling pass
                     found expensive at 10k msg/s (see RowStateClassSync's remarks). Scoped to
                     row-level (whole preview cell), not per-substring, as a proportional
                     simplification of §4.4's literal "matched substring" spec. -->
                <DataGridTemplateColumn Header="PREVIEW" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Preview}" Classes.searchHit="{Binding IsSearchHit}"
                                       VerticalAlignment="Center" Margin="6,0" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
            <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource Surf}" />
                    <Setter Property="Foreground" Value="{DynamicResource Dim}" />
                    <Setter Property="FontFamily" Value="{DynamicResource SansFontFamily}" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Height" Value="24" />
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="MinWidth" Value="0" />
                </Style>
                <Style Selector="DataGridRow">
                    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
                    <Setter Property="FontSize" Value="12.5" />
                    <!-- §4.4: "border-left: 2px solid transparent - the gutter is always
                         reserved so dead-letter marking causes no reflow." Transparent
                         baseline here, overridden to Red only by .deadLettered below. -->
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
                <Style Selector="DataGridRow.odd">
                    <Setter Property="Background" Value="{DynamicResource Line2}" />
                </Style>
                <Style Selector="DataGridRow:pointerover">
                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                </Style>
                <Style Selector="DataGridRow:selected">
                    <Setter Property="Background" Value="{DynamicResource Sel}" />
                </Style>
                <Style Selector="DataGridRow.evicted">
                    <Setter Property="Opacity" Value="0.55" />
                </Style>
                <Style Selector="DataGridRow.deadLettered">
                    <Setter Property="BorderBrush" Value="{DynamicResource Red}" />
                </Style>
                <Style Selector="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource Text}" />
                </Style>
                <!-- Scoped to this DataGrid's own cell templates (see the SIZE column above) -
                     every TextBlock.large in this tree is that one cell, so an unqualified
                     TextBlock selector is safe here without further scoping. -->
                <Style Selector="TextBlock.large">
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </Style>
                <Style Selector="TextBlock.searchHit">
                    <Setter Property="Background" Value="{DynamicResource AmberTint}" />
                    <Setter Property="Foreground" Value="{DynamicResource Amber}" />
                </Style>
            </DataGrid.Styles>
        </DataGrid>

        <!-- Deep search overlay (UI spec §7): a modal-style panel, not a full dialog, anchored
             directly below the search bar. Shares row 4 with the DataGrid and aligns to the top
             of it rather than taking a row of its own - a new RowDefinition here would renumber
             every Grid.Row below it, and the spec wants this over the content anyway. Its
             counter and bar are driven by SearchViewModel's 60 ms ticker, not by the scan's own
             per-message reports; see RefreshDeepScanDisplay for why. -->
        <Border Grid.Row="4" VerticalAlignment="Top" Margin="14,10" Padding="14,12"
                Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" CornerRadius="4" BoxShadow="0 4 16 0 #40000000"
                IsVisible="{Binding Search.IsDeepScanning}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text}"
                           FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                           TextTrimming="CharacterEllipsis"
                           Text="{Binding Search.DeepScanQuery, StringFormat='Deep scan — “{0}”'}" />
                <Button Grid.Row="0" Grid.Column="1" Content="Cancel"
                        Command="{Binding Search.DeepScanCancelCommand}"
                        Background="Transparent" BorderBrush="{DynamicResource Line}"
                        Foreground="{DynamicResource Text}" Padding="10,3" Margin="10,0,0,0"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="4"
                             Margin="0,10" Minimum="0" Maximum="100"
                             Value="{Binding Search.DeepScanProgressValue}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                           Foreground="{DynamicResource Muted}"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Text="{Binding Search.DeepScanStatusText}" />
            </Grid>
        </Border>

        <GridSplitter Grid.Row="5" Height="4" Background="{DynamicResource Line}"
                      ResizeDirection="Rows" Cursor="SizeNorthSouth"
                      HorizontalAlignment="Stretch" />

        <!-- Detail pane. -->
        <Border Grid.Row="6" Background="{DynamicResource Surf}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid RowDefinitions="34,*">
                <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="14,0"
                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Text}"
                                   Text="{Binding Detail.Selected.Subject, FallbackValue='No message selected'}" />
                        <!-- "Use as publish template" (build plan §5 M3 step 10) - schema-infers
                             a generator per leaf from this message's body and opens the
                             publisher panel on it. -->
                        <Button Grid.Column="1" Content="Use as template" IsVisible="{Binding !Detail.IsUnavailable}"
                                Command="{Binding UseSelectedAsTemplateCommand}"
                                Margin="0,0,14,0" Height="22" Padding="8,0"
                                Background="Transparent" BorderBrush="{DynamicResource Line}"
                                Foreground="{DynamicResource Text}"
                                FontFamily="{DynamicResource SansFontFamily}" FontSize="11" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="260,*" Margin="14">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Detail.Selected.Sequence, StringFormat='sequence  {0}'}" />
                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Detail.Selected.Time, StringFormat='time      {0:HH:mm:ss.fff}'}" />
                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Detail.Selected.CorrelationId, StringFormat='corr-id   {0}'}" />
                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Detail.Selected.Size, StringFormat='size      {0} B'}" />
                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Muted}"
                                   Text="{Binding Detail.Selected.Partition, StringFormat='partition {0}'}" />
                        <!-- Pinned fields (build plan §5 M2) - read on demand per selection,
                             not carried live on the ring; see DetailPaneViewModel's remarks. -->
                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                   Foreground="{DynamicResource Muted}" TextWrapping="Wrap"
                                   IsVisible="{Binding Detail.HasPinnedFieldsText}"
                                   Text="{Binding Detail.PinnedFieldsText}" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="{DynamicResource Surf2}" CornerRadius="5"
                            Padding="10" Margin="14,0,0,0">
                        <Panel>
                            <TextBlock Text="Loading…" IsVisible="{Binding Detail.IsLoading}"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                       Foreground="{DynamicResource Dim}" FontStyle="Italic" />
                            <TextBlock Text="{Binding Detail.UnavailableReason}"
                                       IsVisible="{Binding Detail.IsUnavailable}"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                       Foreground="{DynamicResource Dim}" FontStyle="Italic" />
                            <ScrollViewer IsVisible="{Binding !Detail.IsUnavailable}">
                                <TextBlock Text="{Binding Detail.BodyText}"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                           LineHeight="19" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text}" />
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Publisher panel (build plan §5 M3 step 9). x:CompileBindings="False" here for the
             same reason the message grid above sets it: nested ItemsControls bind to several
             disparate model types (PublisherNode, PreviewLine, PreviewSegment) rather than the
             window's own vm:MainWindowViewModel, and setting it once on this subtree is
             simpler than an x:DataType on every DataTemplate below. -->
        <Border Grid.Row="7" Height="380" IsVisible="{Binding IsPublisherOpen}"
                x:CompileBindings="False"
                Background="{DynamicResource Surf}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="3*,2*">
                <!-- Tree editor (60%). -->
                <Grid Grid.Column="0" RowDefinitions="30,22,*">
                    <Border Grid.Row="0" BorderBrush="{DynamicResource Line2}" BorderThickness="0,0,0,1" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="PAYLOAD BUILDER" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                                       LetterSpacing="1" Foreground="{DynamicResource Dim}" />
                            <Button Grid.Column="2" Content="Add field" Command="{Binding Publisher.AddFieldCommand}"
                                    Margin="0,0,8,0" Height="22" Padding="8,0"
                                    Background="Transparent" BorderBrush="{DynamicResource Line}"
                                    Foreground="{DynamicResource Text}"
                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="11" />
                            <Button Grid.Column="3" Content="Regenerate" Command="{Binding Publisher.RegenerateCommand}"
                                    Height="22" Padding="8,0"
                                    Background="Transparent" BorderBrush="{DynamicResource Line}"
                                    Foreground="{DynamicResource Text}"
                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="11" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource Surf2}"
                            BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,92,150,210,78">
                            <TextBlock Grid.Column="0" Text="KEY" Margin="8,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5"
                                       Foreground="{DynamicResource Dim}" />
                            <TextBlock Grid.Column="1" Text="TYPE" Margin="8,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5"
                                       Foreground="{DynamicResource Dim}" />
                            <TextBlock Grid.Column="2" Text="VALUE" Margin="8,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5"
                                       Foreground="{DynamicResource Dim}" />
                            <TextBlock Grid.Column="3" Text="GENERATOR" Margin="8,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5"
                                       Foreground="{DynamicResource Dim}" />
                        </Grid>
                    </Border>

                    <!-- One row per flattened tree node. No hover add-sibling/add-child/duplicate
                         mini-icons here (build plan §4's own mockup markup) — a single header
                         "Add field" plus a per-row delete covers the same editing capability
                         with far less interaction-state code; adding nested children under a
                         non-root object/array is done by first setting a field's own Type to
                         Object/Array, which is what Type is for. -->
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding Publisher.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,92,150,210,78" Height="26">
                                        <Grid.Styles>
                                            <Style Selector="Grid:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource Hover}" />
                                            </Style>
                                        </Grid.Styles>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="16" Margin="{Binding Depth, Converter={x:Static views:DepthToIndentConverter.Instance}}" />
                                            <TextBox Text="{Binding Key, Mode=TwoWay}" IsEnabled="{Binding !IsArrayElement}"
                                                     Height="20" Padding="4,0" BorderThickness="0" Background="Transparent"
                                                     FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                                     Foreground="{DynamicResource Text}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Margin="4,0"
                                                  ItemsSource="{x:Static publisher:PublisherFieldTypes.All}"
                                                  SelectedItem="{Binding Type, Mode=TwoWay}"
                                                  Height="20" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Margin="6,0"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding !IsContainer}"
                                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                                   Foreground="{DynamicResource Text}" />
                                        <TextBox Grid.Column="3" Text="{Binding Generator, Mode=TwoWay}"
                                                 IsVisible="{Binding !IsContainer}" Margin="4,0"
                                                 Height="20" Padding="4,0" BorderThickness="1"
                                                 BorderBrush="{DynamicResource Line2}" Background="{DynamicResource Surf2}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="10.5"
                                                 Foreground="{DynamicResource Accent}" />
                                        <Button Grid.Column="4" Content="×" Command="{Binding $parent[ItemsControl].DataContext.Publisher.DeleteFieldCommand}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" Margin="0,0,7,0"
                                                Width="17" Height="17" Padding="0"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource Red}" FontSize="12" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Preview (40%). -->
                <Grid Grid.Column="1" RowDefinitions="30,*,40" Background="{DynamicResource Surf}">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*" Margin="8,0">
                        <ToggleButton Grid.Column="0" Content="Preview" IsChecked="{Binding Publisher.IsPreviewTabSelected}"
                                      Command="{Binding Publisher.SelectPreviewTabCommand}"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource Text}" Padding="10,0"
                                      FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                        <ToggleButton Grid.Column="1" Content="Envelope" IsChecked="{Binding Publisher.IsEnvelopeTabSelected}"
                                      Command="{Binding Publisher.SelectEnvelopeTabCommand}"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource Text}" Padding="10,0"
                                      FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" IsVisible="{Binding Publisher.IsPreviewTabSelected}">
                        <ItemsControl ItemsSource="{Binding Publisher.PreviewLines}" Margin="0,6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Height="19">
                                        <TextBlock Text="{Binding LineNumber}" Width="30" TextAlignment="Right"
                                                   Margin="0,0,8,0" FontFamily="{DynamicResource MonoFontFamily}"
                                                   FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <Border Width="{Binding Indent, Converter={x:Static views:IndentToWidthConverter.Instance}}" />
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Text}"
                                                               FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                                               Classes.key="{Binding IsKey}" Classes.str="{Binding IsString}"
                                                               Classes.num="{Binding IsNumber}" Classes.lit="{Binding IsLiteral}"
                                                               Classes.punct="{Binding IsPunctuation}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" IsVisible="{Binding Publisher.IsEnvelopeTabSelected}">
                        <StackPanel Spacing="1">
                            <Grid ColumnDefinitions="150,*" Height="25" Margin="10,0">
                                <TextBlock Grid.Column="0" Text="Content-Type" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                <TextBox Grid.Column="1" Text="{Binding Publisher.ContentType, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Text}" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*" Height="25" Margin="10,0">
                                <TextBlock Grid.Column="0" Text="Partition Key" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                <TextBox Grid.Column="1" Text="{Binding Publisher.PartitionKey, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Text}" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*" Height="25" Margin="10,0">
                                <TextBlock Grid.Column="0" Text="Session ID" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                <TextBox Grid.Column="1" Text="{Binding Publisher.SessionId, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Text}" />
                            </Grid>
                            <Grid ColumnDefinitions="150,*" Height="25" Margin="10,0">
                                <TextBlock Grid.Column="0" Text="Correlation ID" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Muted}" />
                                <TextBox Grid.Column="1" Text="{Binding Publisher.CorrelationId, Mode=TwoWay}"
                                         BorderThickness="0" Background="Transparent"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" Foreground="{DynamicResource Text}" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,0">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <Button Grid.Column="0" Content="Publish" Command="{Binding Publisher.PublishCommand}"
                                    Height="28" Padding="13,0" Background="Transparent"
                                    BorderBrush="{DynamicResource Accent}" Foreground="{DynamicResource Accent}"
                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button Content="Burst" Command="{Binding Publisher.BurstCommand}"
                                        Height="28" Padding="9,0" Background="Transparent"
                                        BorderBrush="{DynamicResource Line}" Foreground="{DynamicResource Text}"
                                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                                <NumericUpDown Value="{Binding Publisher.BurstCount}" Minimum="1" Increment="1" FormatString="0"
                                               Width="70" Height="28" Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Publisher.ValidationText}"
                                       IsVisible="{Binding Publisher.HasValidationIssue}"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="260"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                       Foreground="{DynamicResource Red}" />
                            <TextBlock Grid.Column="3" Text="{Binding Publisher.PublishStatus}"
                                       IsVisible="{Binding !Publisher.HasValidationIssue}"
                                       VerticalAlignment="Center" TextAlignment="Right"
                                       FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                                       Foreground="{DynamicResource Muted}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Status bar. -->
        <Border Grid.Row="8" Background="{DynamicResource Surf}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Muted}"
                           Text="{Binding StatusBar.TotalAppended, StringFormat='{}{0:N0} total'}" />
                <TextBlock Grid.Column="1" Margin="16,0,0,0"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Muted}"
                           Text="{Binding StatusBar.UiDropped, StringFormat='{}{0:N0} ui-dropped'}" />
                <TextBlock Grid.Column="2" Margin="16,0,0,0" HorizontalAlignment="Left"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Muted}"
                           IsVisible="{Binding StatusBar.HasIndexLag}"
                           Text="{Binding StatusBar.IndexLag, StringFormat='{}{0:N0} rows behind index'}" />
                <Button Grid.Column="3" Command="{Binding TogglePinCommand}"
                        IsVisible="{Binding StatusBar.IsPinned}"
                        Background="Transparent" BorderBrush="{DynamicResource Accent}"
                        Foreground="{DynamicResource Accent}" Padding="10,2"
                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12">
                    <TextBlock Text="{Binding StatusBar.PinnedNewCount, StringFormat='resume live ({0} new)'}" />
                </Button>
                <TextBlock Grid.Column="4" Margin="16,0,0,0"
                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5"
                           Foreground="{DynamicResource Muted}"
                           Text="{Binding StatusBar.ByteBudgetUsed, StringFormat='{}{0:N0} bytes'}" />
            </Grid>
        </Border>

        <!-- Connection manager / launcher (UI spec §6). Same overlay pattern as the settings
             panel below - a Panel+Border pair in the root grid, not a separate Window or
             UserControl, since this app has no window-management story yet and Settings
             already established the pattern for a modal-shaped surface here. Auto-opened at
             cold start (MainWindowViewModel's constructor) so it doubles as the launcher; the
             tab strip's + and Connect Stage-5-per-spec both reopen it later. -->
        <Panel Grid.Row="0" Grid.RowSpan="9" IsVisible="{Binding IsConnectionManagerOpen}"
               Background="#0A0B12" Opacity="0.58" />
        <Border Grid.Row="0" Grid.RowSpan="9" IsVisible="{Binding IsConnectionManagerOpen}"
                Width="860" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Raise}" CornerRadius="8"
                BoxShadow="0 24 60 0 #80000000"
                x:CompileBindings="False">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="20,16,16,10">
                    <TextBlock Grid.Column="0" Text="Connections" FontFamily="{DynamicResource SansFontFamily}"
                               FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" />
                    <Button Grid.Column="1" Content="Close"
                            Command="{Binding ToggleConnectionManagerCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Line}"
                            Foreground="{DynamicResource Text}" Padding="12,4"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="280,*">
                    <!-- Left: saved connections list (UI spec §6). Grouping by broker type is
                         cosmetic and deferred to Stage 5 polish - today there is exactly one
                         real broker kind (Kafka) plus the built-in Fake source, so a flat list
                         with each row's own Kind label carries the same information. -->
                    <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0">
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding ConnectionManager.SavedConnections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="16,10">
                                            <Grid.Styles>
                                                <Style Selector="Grid:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource Hover}" />
                                                </Style>
                                            </Grid.Styles>
                                            <StackPanel Grid.Column="0" Spacing="2">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                                                           Foreground="{DynamicResource Text}" />
                                                <TextBlock Text="{Binding EndpointDisplay}" TextTrimming="CharacterEllipsis"
                                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11"
                                                           Foreground="{DynamicResource Muted}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Connect"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ConnectionManager.ConnectCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="6,0,0,0" Height="24" Padding="9,0"
                                                    Background="Transparent" BorderBrush="{DynamicResource Accent}"
                                                    Foreground="{DynamicResource Accent}"
                                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="11.5" />
                                            <Button Grid.Column="2" Content="Edit"
                                                    IsVisible="{Binding IsEditable}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.ConnectionManager.EditConnectionCommand}"
                                                    CommandParameter="{Binding}"
                                                    Margin="6,0,0,0" Height="24" Padding="9,0"
                                                    Background="Transparent" BorderBrush="{DynamicResource Line}"
                                                    Foreground="{DynamicResource Text}"
                                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="11.5" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: the Kafka editor form when adding/editing, else an empty state
                         with three large broker buttons (UI spec §6). ASB/SQS render disabled
                         with a tooltip - the capability-gated-control wrapper from §9 - since
                         those sources don't exist until M4, not hidden outright. -->
                    <Grid Grid.Column="1" IsVisible="{Binding !ConnectionManager.IsEditing}"
                          RowDefinitions="*" Margin="20">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
                            <TextBlock Text="Add a connection" HorizontalAlignment="Center"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="13"
                                       Foreground="{DynamicResource Dim}" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Kafka" Command="{Binding ConnectionManager.NewKafkaConnectionCommand}"
                                        Width="140" Height="72"
                                        Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Accent}"
                                        Foreground="{DynamicResource Accent}"
                                        FontFamily="{DynamicResource SansFontFamily}" FontSize="13" />
                                <Button Content="Azure Service Bus" Width="140" Height="72" IsEnabled="False"
                                        Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Line}"
                                        Foreground="{DynamicResource Text}" Opacity="0.4"
                                        FontFamily="{DynamicResource SansFontFamily}" FontSize="13"
                                        ToolTip.Tip="Available in a future milestone (M4)." />
                                <Button Content="AWS SQS" Width="140" Height="72" IsEnabled="False"
                                        Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Line}"
                                        Foreground="{DynamicResource Text}" Opacity="0.4"
                                        FontFamily="{DynamicResource SansFontFamily}" FontSize="13"
                                        ToolTip.Tip="Available in a future milestone (M4)." />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Column="1" IsVisible="{Binding ConnectionManager.IsEditing}"
                          RowDefinitions="*,Auto" Margin="20,16,20,16">
                        <ScrollViewer Grid.Row="0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="KAFKA CONNECTION" FontFamily="{DynamicResource SansFontFamily}"
                                           FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="NAME" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                    <TextBox Text="{Binding ConnectionManager.EditName, Mode=TwoWay}"
                                             Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                             FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="BOOTSTRAP SERVERS" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                    <TextBox Text="{Binding ConnectionManager.EditBootstrapServers, Mode=TwoWay}" Watermark="broker1:9092,broker2:9092"
                                             Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                             FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                </StackPanel>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="TOPICS (COMMA-SEPARATED)" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditTopics, Mode=TwoWay}"
                                                 Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="PUBLISH TOPIC" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditPublishTopic, Mode=TwoWay}" Watermark="defaults to first topic"
                                                 Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="CONSUMER GROUP PREFIX" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditGroupIdPrefix, Mode=TwoWay}"
                                                 Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="PARTITION (BLANK = ALL)" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditPartitionText, Mode=TwoWay}"
                                                 Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                </Grid>


                                <!-- Start position. The only control here that decides whether the
                                     tool reads what is already on the topic; everything else is
                                     about how to connect. -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="START FROM" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <ComboBox ItemsSource="{x:Static vm:ConnectionManagerViewModel.StartFromOptions}"
                                                  SelectedItem="{Binding ConnectionManager.EditStartFrom, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"
                                                IsVisible="{Binding ConnectionManager.IsStartFromTimestamp}">
                                        <TextBlock Text="FROM (UTC)" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditStartTimestampText, Mode=TwoWay}"
                                                 Watermark="yyyy-MM-dd HH:mm:ss"
                                                 Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Line}"
                                                 Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4"
                                                IsVisible="{Binding ConnectionManager.IsStartFromOffset}">
                                        <TextBlock Text="FROM OFFSET" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditStartOffsetText, Mode=TwoWay}"
                                                 Watermark="requires a partition"
                                                 Background="{DynamicResource Surf2}" BorderBrush="{DynamicResource Line}"
                                                 Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5" />
                                    </StackPanel>
                                </Grid>

                                <!-- Earliest is safe for the broker and costly locally, which is the
                                     opposite of what the word suggests. Say both. -->
                                <TextBlock IsVisible="{Binding ConnectionManager.IsStartFromEarliest}"
                                           TextWrapping="Wrap"
                                           FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource Amber}"
                                           Text="Reads everything the topic still retains. Safe for the broker — this tool never commits offsets — but a large topic will fill the local capture, evict the oldest of it, and leave search indexing behind while it catches up." />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="SECURITY PROTOCOL" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <ComboBox ItemsSource="{x:Static vm:ConnectionManagerViewModel.SecurityProtocolOptions}"
                                                  SelectedItem="{Binding ConnectionManager.EditSecurityProtocol, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                  FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="SASL MECHANISM" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <ComboBox ItemsSource="{x:Static vm:ConnectionManagerViewModel.SaslMechanismOptions}"
                                                  SelectedItem="{Binding ConnectionManager.EditSaslMechanism, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                  FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="SASL USERNAME" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditSaslUsername, Mode=TwoWay}"
                                                 Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="SASL PASSWORD" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                        <TextBox Text="{Binding ConnectionManager.EditSaslPasswordInput, Mode=TwoWay}" PasswordChar="•"
                                                 Watermark="{Binding ConnectionManager.PasswordWatermark}"
                                                 Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                                 FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="SSL CA LOCATION (OPTIONAL)" FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5" Foreground="{DynamicResource Dim}" />
                                    <TextBox Text="{Binding ConnectionManager.EditSslCaLocation, Mode=TwoWay}"
                                             Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                             FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                </StackPanel>

                                <TextBlock Text="{Binding ConnectionManager.ValidationError}"
                                           IsVisible="{Binding ConnectionManager.HasValidationError}"
                                           FontFamily="{DynamicResource SansFontFamily}" FontSize="11.5"
                                           Foreground="{DynamicResource Red}" TextWrapping="Wrap" />

                                <!-- Test connection: idle / spinner / result, per UI spec §6.
                                     A text status stands in for an animated spinner control -
                                     this codebase has none yet (see the search bar's own
                                     text-only "index catching up" indicator for the same
                                     proportionality call). -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Button Grid.Column="0" Content="Test connection"
                                            Command="{Binding ConnectionManager.TestConnectionCommand}"
                                            Background="Transparent" BorderBrush="{DynamicResource Line}"
                                            Foreground="{DynamicResource Text}" Padding="10,4"
                                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12" />
                                    <TextBlock Grid.Column="1" Text="Testing…" IsVisible="{Binding ConnectionManager.IsTesting}"
                                               Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontFamily="{DynamicResource SansFontFamily}" FontSize="12"
                                               Foreground="{DynamicResource Muted}" />
                                </Grid>
                                <TextBlock Text="{Binding ConnectionManager.TestResultText}" TextWrapping="Wrap"
                                           IsVisible="{Binding ConnectionManager.IsTestSuccess}"
                                           Foreground="{DynamicResource Green}"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" />
                                <TextBlock Text="{Binding ConnectionManager.TestResultText}" TextWrapping="Wrap"
                                           IsVisible="{Binding ConnectionManager.IsTestFailure}"
                                           Foreground="{DynamicResource Red}"
                                           FontFamily="{DynamicResource MonoFontFamily}" FontSize="11.5" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Cancel" Command="{Binding ConnectionManager.CancelEditCommand}"
                                    Background="Transparent" BorderBrush="{DynamicResource Line}"
                                    Foreground="{DynamicResource Text}" Padding="12,4"
                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                            <Button Content="Delete" IsVisible="{Binding ConnectionManager.IsEditingExisting}"
                                    Command="{Binding ConnectionManager.DeleteEditingConnectionCommand}"
                                    Background="Transparent" BorderBrush="{DynamicResource Red}"
                                    Foreground="{DynamicResource Red}" Padding="12,4"
                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                            <Button Content="Save" Command="{Binding ConnectionManager.SaveCommand}"
                                    Background="Transparent" BorderBrush="{DynamicResource Accent}"
                                    Foreground="{DynamicResource Accent}" Padding="12,4"
                                    FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Settings overlay (build plan §5 M2). A Panel in the root grid with an IsVisible
             binding, not a Window - per the mockup-to-Avalonia mapping table's rule for
             modal-shaped surfaces (the same pattern the deep-search overlay will use in
             Stage 5). Spans every row so the scrim covers the whole window. -->
        <Panel Grid.Row="0" Grid.RowSpan="9" IsVisible="{Binding IsSettingsOpen}"
               Background="#0A0B12" Opacity="0.58" />
        <Border Grid.Row="0" Grid.RowSpan="9" IsVisible="{Binding IsSettingsOpen}"
                Width="440" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Raise}" CornerRadius="8" Padding="20"
                BoxShadow="0 24 60 0 #80000000">
            <ScrollViewer>
                <StackPanel Spacing="14">
                    <TextBlock Text="Settings" FontFamily="{DynamicResource SansFontFamily}"
                               FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="RETENTION CAP (MB)" FontFamily="{DynamicResource SansFontFamily}"
                                   FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />
                        <NumericUpDown Value="{Binding Settings.RetentionCapMegabytes}"
                                       Minimum="1" Increment="100" FormatString="0"
                                       Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="RETENTION DAYS" FontFamily="{DynamicResource SansFontFamily}"
                                   FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />
                        <NumericUpDown Value="{Binding Settings.RetentionDays}"
                                       Minimum="1" Increment="1" FormatString="0"
                                       Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="INDEXED PREFIX (BYTES)" FontFamily="{DynamicResource SansFontFamily}"
                                   FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />
                        <NumericUpDown Value="{Binding Settings.IndexedPrefixBytes}"
                                       Minimum="256" Increment="256" FormatString="0"
                                       Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}" />
                        <TextBlock Text="Applies to new connections only (Stop, then Start)."
                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                                   Foreground="{DynamicResource Dim}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="PINNED FIELDS" FontFamily="{DynamicResource SansFontFamily}"
                                       FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />

                            <ItemsControl ItemsSource="{Binding Settings.PinnedFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="{DynamicResource MonoFontFamily}" FontSize="12"
                                                   Foreground="{DynamicResource Text}">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  →  {1}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="JsonPath" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                                <TextBox Grid.Column="0" Watermark="name" Text="{Binding Settings.NewPinnedFieldName}"
                                         Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                <TextBox Grid.Column="1" Watermark="$.path" Text="{Binding Settings.NewPinnedFieldPath}"
                                         Background="{DynamicResource Surf2}" Foreground="{DynamicResource Text}"
                                         FontFamily="{DynamicResource MonoFontFamily}" FontSize="12" />
                                <Button Grid.Column="2" Content="Add" Command="{Binding Settings.AddPinnedFieldCommand}"
                                        Background="Transparent" BorderBrush="{DynamicResource Accent}"
                                        Foreground="{DynamicResource Accent}" Padding="10,4"
                                        FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                            </Grid>

                            <TextBlock Text="{Binding Settings.ValidationError}"
                                       IsVisible="{Binding Settings.HasValidationError}"
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="11.5"
                                       Foreground="{DynamicResource Red}" TextWrapping="Wrap" />

                            <TextBlock Text="A pinned field extracts a JSON path from the indexed prefix - values past that cutoff resolve to nothing. Applies to the running connection immediately; existing rows are unaffected until re-read."
                                       FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                                       Foreground="{DynamicResource Dim}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Settings.SavedMessage}" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="12"
                                   Foreground="{DynamicResource Green}" />
                        <Button Content="Save" Command="{Binding Settings.SaveCommand}"
                                Background="Transparent" BorderBrush="{DynamicResource Accent}"
                                Foreground="{DynamicResource Accent}" Padding="12,4"
                                FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                        <Button Content="Close" Command="{Binding ToggleSettingsCommand}"
                                Background="Transparent" BorderBrush="{DynamicResource Line}"
                                Foreground="{DynamicResource Text}" Padding="12,4"
                                FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- History browser. Same overlay shape as the settings and connection-manager surfaces
             (a Panel scrim plus a Border, not a Window) per the mockup-to-Avalonia mapping rule.
             Picking a day is what switches the grid; opening this drawer on its own does not. -->
        <Panel Grid.Row="0" Grid.RowSpan="9" IsVisible="{Binding IsHistoryOpen}"
               Background="#0A0B12" Opacity="0.58" />
        <!-- x:CompileBindings="False" for the same reason the connection manager sets it: the
             ListBox item templates below bind against SessionEntry/DayEntry rather than the
             window's own data type. -->
        <Border Grid.Row="0" Grid.RowSpan="9" IsVisible="{Binding IsHistoryOpen}"
                x:CompileBindings="False"
                Width="560" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Raise}" CornerRadius="8" Padding="20"
                BoxShadow="0 24 60 0 #80000000">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,14">
                    <TextBlock Text="History" FontFamily="{DynamicResource SansFontFamily}"
                               FontSize="14" FontWeight="Medium" Foreground="{DynamicResource Text}" />
                    <TextBlock Text="Everything already captured on this machine. Reading it does not touch the broker."
                               FontFamily="{DynamicResource SansFontFamily}" FontSize="11.5"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                </StackPanel>

                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,14,0,0">
                    <TextBlock Grid.Column="0" Text="{Binding History.StatusText}"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               FontFamily="{DynamicResource SansFontFamily}" FontSize="11.5"
                               Foreground="{DynamicResource Muted}" />
                    <Button Grid.Column="1" Content="Close" Command="{Binding ToggleHistoryCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Line}"
                            Foreground="{DynamicResource Text}" Padding="10,4" Margin="8,0,0,0"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                    <Button Grid.Column="2" Content="Open all days" Command="{Binding History.OpenSessionCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource Line}"
                            Foreground="{DynamicResource Text}" Padding="10,4" Margin="8,0,0,0"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" />
                    <Button Grid.Column="3" Content="Open day" Command="{Binding History.OpenDayCommand}"
                            Background="{DynamicResource Accent}" BorderThickness="0"
                            Foreground="#0A0B12" Padding="12,4" Margin="8,0,0,0"
                            FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5" FontWeight="Medium" />
                </Grid>

                <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Spacing="6">
                        <TextBlock Text="CAPTURE" FontFamily="{DynamicResource SansFontFamily}"
                                   FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />
                        <ListBox ItemsSource="{Binding History.Sessions}"
                                 SelectedItem="{Binding History.SelectedSession}"
                                 MaxHeight="320" Background="{DynamicResource Surf2}"
                                 BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,2">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="12.5"
                                                   Foreground="{DynamicResource Text}" />
                                        <TextBlock FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource Muted}"
                                                   Text="{Binding DayCount, StringFormat='{}{0} day(s)'}" />
                                        <!-- The shared-root and deleted-connection cases both surface
                                             here rather than being papered over. -->
                                        <TextBlock Text="{Binding Note}"
                                                   IsVisible="{Binding Note, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                   TextWrapping="Wrap"
                                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="10.5"
                                                   Foreground="{DynamicResource Amber}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="6">
                        <TextBlock Text="DAY" FontFamily="{DynamicResource SansFontFamily}"
                                   FontSize="11" LetterSpacing="1" Foreground="{DynamicResource Dim}" />
                        <ListBox ItemsSource="{Binding History.Days}"
                                 SelectedItem="{Binding History.SelectedDay}"
                                 MaxHeight="320" Background="{DynamicResource Surf2}"
                                 BorderBrush="{DynamicResource Line}" BorderThickness="1">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,2">
                                        <TextBlock Text="{Binding Day}"
                                                   FontFamily="{DynamicResource MonoFontFamily}" FontSize="12.5"
                                                   Foreground="{DynamicResource Text}" />
                                        <TextBlock Text="{Binding CountLabel}"
                                                   FontFamily="{DynamicResource SansFontFamily}" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
