<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Deliberately does NOT reference Avalonia.Headless or call any Avalonia setup API.
      MessageRowsView/IngestPipeline reference Avalonia types (IDataGridCollectionView etc.)
      but don't need the platform *running* to append/read data — only EventScope.App.Tests'
      DataGrid/Window-based tests need that. Measured directly: the very first real async
      file I/O (SegmentReader.ReadAsync, or the SQLite path underneath IngestPipeline) issued
      in a process where Avalonia's headless dispatcher has been set up via
      AppBuilder...SetupWithoutStarting() can hang indefinitely with no CPU activity,
      depending on test execution order — reproduces even against a pre-existing,
      already-shipped test (IngestPipelineStorageTests) when it happens to run first. See
      PROGRESS.md. Keeping these two acceptance tests in a process that never touches
      Avalonia's platform at all sidesteps the interaction rather than chasing its root cause.
    -->
    <ProjectReference Include="..\..\src\EventScope.Core\EventScope.Core.csproj" />
    <ProjectReference Include="..\..\src\EventScope.Storage\EventScope.Storage.csproj" />
    <ProjectReference Include="..\..\src\EventScope.App\EventScope.App.csproj" />
  </ItemGroup>

</Project>
